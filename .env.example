# Confidence Arise Growth Agent — secrets (do not commit)
PORT=4174

# Naeema-only login
AUTH_EMAIL=naeemah@confidencearise.org
AUTH_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-long-random-string
# Used to encrypt connected mailbox credentials at rest. Use a long random secret in production.
EMAIL_SETTINGS_SECRET=change-me-another-long-random-string
WHATSAPP_SETTINGS_SECRET=change-me-whatsapp-random-string

SITE_URL=https://confidencearise.com
FROM_NAME=Confidence Arise
FROM_EMAIL=hello@confidencearise.com

RESEND_API_KEY=

# Persistent SMTP fallback (recommended on Render because local files are ephemeral)
SMTP_PROVIDER=custom
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_NAME=Confidence Arise
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# AI concierge
OPENAI_API_KEY=
OPENAI_CONCIERGE_MODEL=gpt-6-luna

# Optional multi-source business discovery
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
BING_SEARCH_API_KEY=

# Optional inbound mailbox polling. Manual "Sync email replies" works without enabling the timer.
EMAIL_REPLY_SYNC_ENABLED=false
EMAIL_REPLY_SYNC_MINUTES=10

# Approved campaign auto-follow-ups. Sequence runs at day 3, day 7 and day 14.
AUTO_FOLLOWUP_ENABLED=false
AUTO_FOLLOWUP_MINUTES=60

# Meta App Secret used to verify X-Hub-Signature-256 on inbound WhatsApp webhooks
WHATSAPP_APP_SECRET=
